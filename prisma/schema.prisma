// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// User model for authentication
model User {
  id                String   @id @default(uuid())
  email             String   @unique
  password          String
  name              String
  roleId            String
  role              Role     @relation(fields: [roleId], references: [id])
  
  // 2FA Configuration
  twoFactorEnabled  Boolean  @default(false)
  twoFactorMethod   String?  // 'email' or 'totp'
  totpSecret        String?  // For Google Authenticator
  emailOTP          String?  // Current OTP for email method
  emailOTPExpiry    DateTime? // OTP expiration time
  
  // Timestamps
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  lastLogin         DateTime?
  
  // Relations
  activityLogs      ActivityLog[]
  errorReports      ErrorReport[]
  scheduledTasks    ScheduledTask[]
  
  @@index([roleId])
  @@index([email])
}

// Role model for RBAC
model Role {
  id          String       @id @default(uuid())
  name        String       @unique // 'Super Admin', 'Admin', 'Moderator'
  description String?
  
  // Timestamps
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  
  // Relations
  users       User[]
  permissions Permission[]
}

// Permission model for RBAC
model Permission {
  id          String   @id @default(uuid())
  roleId      String
  role        Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  
  // Permission details
  resource    String   // e.g., 'logs', 'users', 'roles', 'dashboard', 'server'
  action      String   // e.g., 'read', 'write', 'delete', 'manage'
  
  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([roleId, resource, action])
  @@index([roleId])
}

// Activity Log model for tracking user actions
model ActivityLog {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Action details
  actionType  String   // e.g., 'login', 'logout', 'create_user', 'update_role', 'server_command'
  resource    String?  // e.g., 'user', 'role', 'server'
  resourceId  String?  // ID of affected resource
  details     String?  @db.Text // JSON string with additional details
  
  // Request metadata
  ipAddress   String?
  userAgent   String?  @db.Text
  
  // Timestamp
  timestamp   DateTime @default(now())
  
  @@index([userId])
  @@index([timestamp])
  @@index([actionType])
}

// Error Report model for tracking and managing error reports
model ErrorReport {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Report details
  title         String
  description   String   @db.Text
  severity      String   // 'low', 'medium', 'high', 'critical'
  status        String   @default("open") // 'open', 'in_progress', 'resolved', 'closed'
  
  // Optional metadata
  page          String?  // Page/route where error occurred
  stackTrace    String?  @db.Text
  userAgent     String?  @db.Text
  ipAddress     String?
  
  // Resolution
  resolvedById  String?
  resolvedAt    DateTime?
  resolution    String?  @db.Text
  
  // Timestamps
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([userId])
  @@index([status])
  @@index([severity])
  @@index([createdAt])
}

// Scheduled Task model for managing automated server actions
model ScheduledTask {
  id            String   @id @default(uuid())
  userId        String   // User who created the task
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Task details
  name          String
  description   String?  @db.Text
  taskType      String   // 'backup', 'cleanup', 'ban', 'unban', 'custom'
  status        String   @default("active") // 'active', 'paused', 'completed', 'failed'
  
  // Schedule configuration
  scheduleType  String   // 'once', 'recurring'
  cronExpression String? // For recurring tasks
  scheduledFor  DateTime? // For one-time tasks
  lastRunAt     DateTime?
  nextRunAt     DateTime?
  
  // Task configuration (JSON)
  config        String?  @db.Text
  
  // Execution details
  executionCount Int     @default(0)
  lastResult    String?  @db.Text
  
  // Timestamps
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([userId])
  @@index([status])
  @@index([nextRunAt])
  @@index([taskType])
}

// Server Metrics model for storing historical monitoring data
model ServerMetrics {
  id                String   @id @default(uuid())
  
  // CPU Metrics
  cpuUsage          Float    // Percentage
  cpuCount          Int?     // Number of CPU cores
  
  // Memory Metrics
  memoryTotal       Float    // Total memory in GB
  memoryUsed        Float    // Used memory in GB
  memoryUsagePercent Float   // Percentage
  
  // Database Metrics
  dbConnections     Int?     // Current database connections
  dbQueryTime       Float?   // Average query time in ms
  dbStatus          String   @default("healthy") // 'healthy', 'degraded', 'down'
  
  // API Metrics
  apiLatency        Float?   // Average API response time in ms
  apiErrorRate      Float?   // Error rate percentage
  apiRequestCount   Int?     // Number of requests in period
  
  // Additional metrics
  uptime            Float?   // Server uptime in seconds
  diskUsage         Float?   // Disk usage percentage
  playerCount       Int?     // Current online player count
  serverOnline      Boolean  @default(false) // Minecraft server online status
  
  // Timestamp
  timestamp         DateTime @default(now())
  
  // Aggregation marker - if true, this is aggregated data
  isAggregated      Boolean  @default(false)
  aggregationPeriod String?  // 'hourly', 'daily', null for raw data
  
  @@index([timestamp])
  @@index([timestamp, isAggregated])
  @@index([isAggregated, aggregationPeriod])
}

// Settings model for system configuration
model Settings {
  id                String   @id @default(uuid())
  key               String   @unique // Setting key identifier
  value             String   @db.Text // Setting value (stored as JSON string)
  category          String   @default("general") // 'metrics', 'general', 'security', etc.
  description       String?  @db.Text // Human-readable description
  
  // Timestamps
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([category])
  @@index([key])
}
