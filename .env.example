# Database Configuration
# MariaDB connection string - Prisma will use this to connect to your database
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://user:password@localhost:3306/smp_admin_panel"

# SMTP Email Configuration
# Used for sending emails (OTP codes for 2FA authentication)
# Configure these to match your iRedMail SMTP server settings
SMTP_HOST="mail.example.com"
SMTP_PORT="587"
SMTP_USER="noreply@example.com"
SMTP_PASS="your-smtp-password"

# NextAuth.js Configuration
# SECRET: A random secure string for session encryption and JWT tokens
# Generate using: openssl rand -base64 32
SECRET="generate-a-random-secure-string-here"

# NextAuth URL - The base URL of your application
# Note: Include the basePath (/apanel44) in production deployment
NEXTAUTH_URL="http://localhost:3000/apanel44"

# Optional: Additional Configuration
# NODE_ENV="development"
