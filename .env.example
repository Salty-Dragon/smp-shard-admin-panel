# Database Configuration
# MariaDB connection string - Prisma will use this to connect to your database
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://user:password@localhost:3306/smp_admin_panel"

# SMTP Email Configuration
# Used for sending emails (OTP codes for 2FA authentication)
# Configure these to match your iRedMail SMTP server settings
SMTP_HOST="mail.example.com"
SMTP_PORT="587"
SMTP_USER="noreply@example.com"
SMTP_PASS="your-smtp-password"

# NextAuth.js Configuration
# SECRET: A random secure string for session encryption and JWT tokens
# Generate using: openssl rand -base64 32
SECRET="generate-a-random-secure-string-here"

# NextAuth URL - The base URL of your application
# IMPORTANT: Include the basePath (/apanel44) in the URL for authentication to work correctly
# For local development:
NEXTAUTH_URL="http://localhost:3000/apanel44"
# For production (example):
# NEXTAUTH_URL="https://v1rtopia.com/apanel44"

# Log Access Password
# Password required for Super Admins to access detailed activity logs
# Change this in production to a strong password
LOG_ACCESS_PASSWORD="logaccess123"

# Debug Token (Optional)
# Token required to access debug endpoints in production
# Only needed if you want to debug production issues
# Generate using: openssl rand -base64 32
# DEBUG_TOKEN="generate-a-random-secure-string-here"

# Metrics Collection Token (Optional)
# Token required for automated metrics collection endpoint
# Use the same token as DEBUG_TOKEN or generate a new one
# This is used by cron jobs or external schedulers to automatically collect metrics
# Generate using: openssl rand -base64 32
# METRICS_COLLECTION_TOKEN="generate-a-random-secure-string-here"

# Minecraft Server Configuration
# The name of the tmux session running the Minecraft server
# This should match the session name used when starting your Minecraft server
MINECRAFT_SERVER_SESSION="minecraft-server"

# Server directory path - Path to the Minecraft server directory
# Used for server version detection and updates
# Default: /opt/minecraft/server
SERVER_DIR="/opt/minecraft/server"

# Minecraft start script - Path to the script used to start the server
# Used for server restarts and updates
# Default: ./start.sh
MINECRAFT_START_SCRIPT="./start.sh"

# Optional: Minecraft Server Query Protocol (alternative to console commands)
# If using Query Protocol instead of console commands, uncomment and configure:
# MINECRAFT_SERVER_HOST="localhost"
# MINECRAFT_SERVER_PORT="25565"

# Optional: Additional Configuration
# NODE_ENV="development"
